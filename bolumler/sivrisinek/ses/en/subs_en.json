{"display": {"200-pound": "two-hundred-pound", "300": "three hundred"},
 "lines": [
  [[1,1,"If a mosquito"], [1,4,"grew to"], [1,6,"your size"], [1,8,"overnight,"]],
  [[2,1,"you'd wake up"], [2,4,"to a"], [2,6,"200-pound bug"], [2,8,"staring at you"], [2,11,"from the end"], [2,14,"of your bed."]],
  [[3,1,"You'd pull"], [3,3,"the blanket"], [3,5,"over your head,"], [3,8,"but it would"], [3,11,"stab its needle"], [3,14,"right through"], [3,16,"the blanket"], [3,18,"into your arm"]],
  [[4,1,"and suck out"], [4,4,"all your blood"], [4,7,"in one go,"], [4,10,"like juice"], [4,12,"through a straw."]],
  [[5,1,"As you"], [5,3,"shrivel up"], [5,5,"like a"], [5,7,"dry leaf,"], [5,9,"its belly"], [5,11,"swells up"], [5,13,"like a balloon."]],
  [[6,1,"Then it tries"], [6,4,"to leave"], [6,6,"through the door."]],
  [[7,1,"On its very"], [7,4,"first step,"], [7,6,"its legs snap"], [7,9,"like spaghetti,"], [7,11,"and it collapses,"], [7,14,"gasping for air."]],
  [[8,1,"That's because"], [8,3,"mosquitoes"], [8,4,"don't have lungs;"], [8,7,"their tiny"], [8,9,"air tubes"], [8,11,"can't get enough"], [8,14,"oxygen"], [8,15,"to a body"], [8,18,"that big."]],
  [[9,1,"And when"], [9,3,"it grows"], [9,5,"300 times"], [9,8,"taller,"], [9,9,"its weight"], [9,11,"goes up"], [9,13,"millions of times,"], [9,16,"but its legs"], [9,19,"don't get"], [9,21,"nearly"], [9,22,"that strong."]],
  [[10,1,"So it could"], [10,4,"drain you dry,"], [10,7,"but it would"], [10,10,"never even"], [10,12,"make it"], [10,14,"to the door."]]
 ]}
